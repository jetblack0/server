{#
  Two things here can only be known once the machine is in front of us: where
  this distro keeps zsh, and which nerd font glyph stands for it -- the same
  glyph the zsh prompt uses, which is what the copy-mode search below jumps
  between. See roles/dotfiles/vars/main.yml.
-#}
# Terminal
# ---------------------------------------------
set -g default-terminal "xterm-256color"
set-option -ga terminal-overrides ",xterm-kitty:Tc"

# extended keys, so kitty can send shift+enter etc; clipboard, so a yank
# leaves the server over OSC 52 and lands in the local clipboard.
set -s extended-keys on
set -as terminal-features 'xterm*:extkeys:clipboard'

set -g focus-events on
set -g set-clipboard on
set -g allow-passthrough on            # yazi's image preview
set -ga update-environment TERM
set -ga update-environment TERM_PROGRAM

# The login shell stays whatever the distro set, so tmux is told explicitly.
set-option -g default-shell {{ dotfiles_zsh }}
# ---------------------------------------------


# General
# ---------------------------------------------
set -s escape-time 1                   # avoid ESC delay
set -g base-index 1
setw -g pane-base-index 1
set -g mouse on                        # mouse works as expected
set -g mode-keys vi
set -g history-limit 10000

setw -g monitor-activity on
set -g visual-activity off

# What tmux-sensible would have set, without pulling in a plugin manager.
set -g display-time 4000
set -g status-interval 5
setw -g aggressive-resize on
# ---------------------------------------------


# Colorscheme
# ---------------------------------------------
source ~/.config/tmux/themes/gruvbox/gruvbox-transparent.conf
# ---------------------------------------------


# Prefix
# ---------------------------------------------
unbind C-b
set -g prefix C-a
bind C-a send-prefix

bind b set-option -g status
bind r source-file ~/.config/tmux/tmux.conf
# ---------------------------------------------


# Copy mode
# ---------------------------------------------
bind Escape copy-mode
unbind p
bind p paste-buffer
bind-key -T copy-mode-vi 'v' send -X begin-selection
bind-key -T copy-mode-vi 'y' send -X copy-selection
# to the previous and next prompt.
bind-key -T copy-mode-vi '.' send -X search-forward "{{ dotfiles_prompt_icon }} "
bind-key -T copy-mode-vi ',' send -X search-backward "{{ dotfiles_prompt_icon }} "
# ---------------------------------------------


# Panes and windows
# ---------------------------------------------
# split and open in the same directory (it will follow link).
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
unbind '"'
unbind %

# moving between window.
bind N prev

# resize panes
bind -r H resize-pane -L 2
bind -r J resize-pane -D 2
bind -r K resize-pane -U 2
bind -r L resize-pane -R 2

# swap the current pane in a direction.
bind -r C-h swap-pane -s '{left-of}'
bind -r C-j swap-pane -s '{down-of}'
bind -r C-k swap-pane -s '{up-of}'
bind -r C-l swap-pane -s '{right-of}'

# Focus panes. On a desktop these first ask nvim whether it wants the key --
# nothing here runs the plugin that answers, so they just move.
bind-key -n C-h select-pane -L
bind-key -n C-j select-pane -D
bind-key -n C-k select-pane -U
bind-key -n C-l select-pane -R

bind-key -T copy-mode-vi 'C-h' select-pane -L
bind-key -T copy-mode-vi 'C-j' select-pane -D
bind-key -T copy-mode-vi 'C-k' select-pane -U
bind-key -T copy-mode-vi 'C-l' select-pane -R
bind-key -T copy-mode-vi 'C-\' select-pane -l
# ---------------------------------------------


# Popups
# ---------------------------------------------
bind-key g display-popup -d '#{pane_current_path}' -w 80% -h 80% -E "lazygit"
bind-key s display-popup -d '#{pane_current_path}' -w 60% -h 60% -E "$SHELL"
# ---------------------------------------------
