// RENDERED BY ANSIBLE -- do not edit on the host; change the template + re-run.
{#
  One section per source the caller asked for; nothing renders for the rest.
  static_rules stamps the shared labels on every pipeline, metrics and logs
  alike -- last rule wins, so instance and job beat an alloy_labels entry of
  the same name.
#}
{% macro static_rules(job) %}
{% for key, value in alloy_labels.items() %}
  rule {
    target_label = "{{ key }}"
    replacement  = "{{ value }}"
  }
{% endfor %}
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
  rule {
    target_label = "job"
    replacement  = "{{ job }}"
  }
{% endmacro %}
{% if alloy_metrics | length > 0 %}
// ##############################
// #### Metrics                ##
// ##############################

prometheus.remote_write "default" {
  endpoint {
    url = "{{ alloy_prometheus_url }}"
{% if alloy_prometheus_username | length > 0 %}

    basic_auth {
      username = "{{ alloy_prometheus_username }}"
      password = "{{ alloy_prometheus_password }}"
    }
{% endif %}
  }
}
{% endif %}
{% if 'node' in alloy_metrics %}

// Host metrics: the node-exporter set.
prometheus.exporter.unix "node" {
  disable_collectors = ["ipvs", "btrfs", "infiniband", "xfs", "zfs"]
  enable_collectors  = ["meminfo"]

  // the extension point: any *.prom file dropped here is exported too,
  // no alloy knowledge required
  textfile {
    directory = "/var/lib/alloy/textfile"
  }

  filesystem {
    fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|tmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
    mount_points_exclude = "^/(dev|proc|run/credentials/.+|sys|var/lib/docker/.+)($|/)"
    mount_timeout        = "5s"
  }

  netclass {
    ignored_devices = "^(veth.*|cali.*|[a-f0-9]{15})$"
  }

  netdev {
    device_exclude = "^(veth.*|cali.*|[a-f0-9]{15})$"
  }
}

discovery.relabel "node" {
  targets = prometheus.exporter.unix.node.targets
{{ static_rules("node-exporter") -}}
}

prometheus.scrape "node" {
  targets    = discovery.relabel.node.output
  forward_to = [prometheus.remote_write.default.receiver]
}
{% endif %}
{% if 'docker' in alloy_metrics %}

// Container metrics: the embedded cAdvisor, containers only, with an
// explicit metric allowlist to keep cardinality flat.
prometheus.exporter.cadvisor "docker" {
  docker_only                  = true
  disable_root_cgroup_stats    = true
  store_container_labels       = false
  allowlisted_container_labels = ["com.docker.compose.project", "com.docker.compose.service"]
  enabled_metrics              = ["cpu", "memory", "network", "diskIO", "oom_event"]
}

discovery.relabel "docker_metrics" {
  targets = prometheus.exporter.cadvisor.docker.targets
{{ static_rules("cadvisor") -}}
}

prometheus.scrape "docker_metrics" {
  targets    = discovery.relabel.docker_metrics.output
  forward_to = [prometheus.relabel.docker_metrics.receiver]
}

prometheus.relabel "docker_metrics" {
  forward_to = [prometheus.remote_write.default.receiver]

  // bare container id, not the cgroup path -- covers both cgroup drivers:
  // cgroupfs (/docker/<id>) and systemd (/system.slice/docker-<id>.scope)
  rule {
    source_labels = ["id"]
    regex         = "(?:/system\\.slice/docker-|/docker/)([a-f0-9]+)(?:\\.scope)?"
    target_label  = "id"
  }
  rule {
    source_labels = ["container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
  rule {
    source_labels = ["container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
  rule {
    regex  = "container_label_com_docker_compose_(project|service)"
    action = "labeldrop"
  }
  rule {
    source_labels = ["__name__", "name"]
    separator     = ";"
    regex         = "container_.*;"
    action        = "drop"
  }
  // health is docker-handler-only in cadvisor and reads 0 for everything on
  // hosts using the containerd image store -- no signal beats a wrong one
  rule {
    source_labels = ["__name__"]
    regex         = "container_health_state"
    action        = "drop"
  }
}
{% endif %}
{% if alloy_logs | length > 0 %}

// ##############################
// #### Logs                   ##
// ##############################

loki.write "default" {
  endpoint {
    url = "{{ alloy_loki_url }}"
{% if alloy_loki_tenant_id | length > 0 %}
    tenant_id = "{{ alloy_loki_tenant_id }}"
{% endif %}
{% if alloy_loki_username | length > 0 %}

    basic_auth {
      username = "{{ alloy_loki_username }}"
      password = "{{ alloy_loki_password }}"
    }
{% endif %}
  }
}
{% endif %}
{% if 'docker' in alloy_logs %}

// Container logs, straight off the daemon socket.
discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.local.targets
{{ static_rules("docker") }}
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = ".*/(.*)"
    target_label  = "container_name"
  }
  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }
}

loki.source.docker "local" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.local.targets
  relabel_rules = discovery.relabel.docker_logs.rules
  forward_to    = [loki.write.default.receiver]
}
{% endif %}
{% if 'journal' in alloy_logs %}

// systemd journal: every entry, but only low-cardinality fields become
// labels -- the full record stays in the log line.
loki.relabel "journal" {
  forward_to = []
{{ static_rules("systemd-journal") }}
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  // covers entries without a unit (kernel, cron children, sshd, ...)
  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "syslog_identifier"
  }
  rule {
    source_labels = ["__journal__boot_id"]
    target_label  = "boot_id"
  }
  rule {
    source_labels = ["__journal__transport"]
    target_label  = "transport"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "system" {
  // bounds the first-run backfill only; steady-state tailing is unaffected
  max_age       = "{{ alloy_journal_max_age }}"
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.write.default.receiver]
}
{% endif %}
